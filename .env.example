# UZI-Skill · 本地环境变量（可选）
# 把本文件复制为 .env 并填入你自己的值：
#   cp .env.example .env
#   # 然后编辑 .env 填 key

# ─── 东财妙想 Skills Hub API（推荐配置）──────────────────────
# 设置后 UZI-Skill 会优先使用官方 NLP API 做：
#   1. 中文名纠错（"北部港湾" 自动识别为 "北部湾港"）
#   2. 股票行情快照（稳定性远高于爬 push2.eastmoney.com）
# 获取 key（免费）: https://dl.dfcfs.com/m/itc4
MX_APIKEY=

# ─── 其他可选 ─────────────────────────────────────────────
# STOCK_NO_CACHE=1        # 禁用所有 API 缓存，强制重新拉取
# UZI_NO_AUTO_OPEN=1      # 分析完不自动打开浏览器

# ─── Easyclaw Web Search（Perplexity Sonar Pro · v3.3.5 新增）─────
# 如果设置，lib.web_search.search() 会优先调 Perplexity Sonar Pro
# 做「实时搜索 + 综合 + 引用」· 远超 ddgs 的 A 股分析质量。
# 失败 / 未设置时自动回退 ddgs。
#
# 获取渠道: https://easyclaw.work （或企业内部发放）
# EASYCLAW_WEB_SEARCH_API_KEY=
# EASYCLAW_WEB_SEARCH_BASE_URL=https://test-api.easyclaw.work/api/v1/search
# EASYCLAW_WEB_SEARCH_MODEL=perplexity/sonar-pro
# UZI_EASYCLAW_TIMEOUT=30
# UZI_DISABLE_EASYCLAW=1   # 显式禁用，强制走 ddgs（调试用）
